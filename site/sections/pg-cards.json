{
  "version": 2,
  "id": "pg-cards",
  "name": "Card grid",
  "description": "A heading and intro over a grid of cards. A card can have a photo, a label or step number, a title, copy with bullets and up to two links.",
  "css": "[data-bz-section=\"pg-cards\"] .bz-headingblock h2 { margin-bottom: 20px; }\n[data-bz-section=\"pg-cards\"] [data-bz-node=\"pc-intro\"] p { font-size: 16px; line-height: 1.7; margin: 0 0 40px; max-width: 760px; color: var(--copy); }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink [data-bz-node=\"pc-intro\"] p { color: var(--copy-on-dark); }\n[data-bz-section=\"pg-cards\"] .bz-col[data-bz-node=\"pc-head-col\"] > .bz-block--heading:last-child h2 { margin-bottom: 40px; }\n/* Cards: tone follows the band — raised on dark, white on sand, sand on white. */\n[data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-card\"] { border-radius: var(--radius-card); overflow: hidden; background: var(--band-tan); display: flex; flex-direction: column; }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-paper .bz-col[data-bz-node^=\"pc-card\"] { background: var(--card); }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[data-bz-node^=\"pc-card\"] { background: var(--ink-raised); }\n/* \"Lined\" cards carry an accent line; \"outlined\" cards sit on a thin border. (Chosen with the band's Card style.) */\n[data-bz-section=\"pg-cards\"] .bz-section--v-center .bz-col[data-bz-node^=\"pc-card\"] { border-top: 3px solid var(--accent); }\n[data-bz-section=\"pg-cards\"] .bz-section--v-end .bz-col[data-bz-node^=\"pc-card\"] { background: var(--card); border: 1px solid var(--line); }\n[data-bz-section=\"pg-cards\"] .bz-photo--empty { display: none; }\n[data-bz-section=\"pg-cards\"] .bz-block--image .bz-figure { margin: 0; }\n[data-bz-section=\"pg-cards\"] .bz-block--image img { width: 100%; height: 220px; object-fit: cover; border-radius: 0; }\n[data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-card\"] .bz-row { flex: 1; }\n[data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-body\"] { padding: 32px; }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[data-bz-node^=\"pc-body\"] { padding: 28px; }\n[data-bz-section=\"pg-cards\"] [data-bz-node^=\"pc-kicker\"] p { font: 700 12px / normal var(--font-body); letter-spacing: 1.5px; text-transform: uppercase; color: var(--bad); margin: 0 0 10px; }\n[data-bz-section=\"pg-cards\"] [data-bz-node^=\"pc-num\"] p { font: 700 28px / 1 var(--font-heading); color: var(--bad); margin: 0 0 12px; }\n[data-bz-section=\"pg-cards\"] [data-bz-node^=\"pc-title\"] h3 { font-size: 17px; line-height: normal; margin: 0 0 12px; color: var(--ink); }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink [data-bz-node^=\"pc-title\"] h3 { color: var(--card); }\n[data-bz-section=\"pg-cards\"] .bz-col[style*=\"--bz-span:6\"] [data-bz-node^=\"pc-title\"] h3 { font-size: 20px; }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[style*=\"--bz-span:4\"] [data-bz-node^=\"pc-title\"] h3,\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[style*=\"--bz-span:3\"] [data-bz-node^=\"pc-title\"] h3 { font-size: 15px; }\n[data-bz-section=\"pg-cards\"] .bz-block .copy__p, [data-bz-section=\"pg-cards\"] .bz-block .copy__ul { font-size: 14px; line-height: 1.6; }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-block .copy__p, [data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-block .copy__ul { font-size: 14px; }\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[style*=\"--bz-span:4\"] .copy__p,\n[data-bz-section=\"pg-cards\"] .bz-section--bg-ink .bz-col[style*=\"--bz-span:3\"] .copy__p { font-size: 13px; line-height: 1.6; }\n[data-bz-section=\"pg-cards\"] .bz-row[data-bz-node^=\"pc-links-row\"] { margin-top: 12px; }\n/* \"5\" is not a divisor of the 12-column grid, so five across is its own grid. */\n[data-bz-section=\"pg-cards\"] .bz-row:has(> .bz-col[style*=\"--bz-span:5\"]) { grid-template-columns: repeat(5, minmax(0, 1fr)); }\n[data-bz-section=\"pg-cards\"] .bz-row > .bz-col[style*=\"--bz-span:5\"] { grid-column: auto; }\n[data-bz-section=\"pg-cards\"] .bz-col[style*=\"--bz-span:5\"] .bz-col[data-bz-node^=\"pc-body\"] { padding: 22px 18px; }\n@media (max-width: 1100px) { [data-bz-section=\"pg-cards\"] .bz-row:has(> .bz-col[style*=\"--bz-span:5\"]) { grid-template-columns: repeat(12, minmax(0, 1fr)); } [data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-card\"] { grid-column: span 6 / span 6; } }\n@media (max-width: 640px) { [data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-card\"] { grid-column: 1 / -1; } [data-bz-section=\"pg-cards\"] .bz-col[data-bz-node^=\"pc-body\"] { padding: 24px; } }",
  "props": [
    {
      "key": "bg",
      "type": "select",
      "label": "Background",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Dark"
        }
      ],
      "default": "paper"
    },
    {
      "key": "look",
      "type": "select",
      "label": "Card style",
      "options": [
        {
          "value": "start",
          "label": "Plain"
        },
        {
          "value": "center",
          "label": "Accent line on top"
        },
        {
          "value": "end",
          "label": "White with outline"
        }
      ],
      "default": "start"
    },
    {
      "key": "span",
      "type": "number",
      "label": "Card width (6 = two across, 4 = three, 3 = four)",
      "default": 4
    },
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Label above the heading"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading"
    },
    {
      "key": "intro",
      "type": "textarea",
      "label": "Intro paragraph"
    },
    {
      "key": "cards",
      "type": "list",
      "label": "Cards",
      "fields": [
        {
          "key": "image",
          "type": "image",
          "label": "Photo"
        },
        {
          "key": "kicker",
          "type": "text",
          "label": "Small label"
        },
        {
          "key": "number",
          "type": "text",
          "label": "Step number"
        },
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "copy",
          "type": "list",
          "label": "Body copy (paragraph, then optional bullets)",
          "fields": [
            {
              "key": "text",
              "type": "textarea",
              "label": "Paragraph"
            },
            {
              "key": "label",
              "type": "boolean",
              "label": "Show as a small bold lead-in (e.g. \"We provide:\")"
            },
            {
              "key": "note",
              "type": "boolean",
              "label": "Show as a bold highlighted note (e.g. \"Timeline: …\")"
            },
            {
              "key": "bars",
              "type": "boolean",
              "label": "Bullets use a line on the left instead of dots"
            },
            {
              "key": "bullets",
              "type": "list",
              "label": "Bullets",
              "fields": [
                {
                  "key": "item",
                  "type": "text",
                  "label": "Bullet"
                }
              ]
            }
          ]
        },
        {
          "key": "link1Label",
          "type": "text",
          "label": "First link text"
        },
        {
          "key": "link1Url",
          "type": "url",
          "label": "First link goes to"
        },
        {
          "key": "link2Label",
          "type": "text",
          "label": "Second link text"
        },
        {
          "key": "link2Url",
          "type": "url",
          "label": "Second link goes to"
        }
      ]
    },
    {
      "key": "links",
      "type": "list",
      "label": "Links under the cards",
      "fields": [
        {
          "key": "label",
          "type": "text",
          "label": "Link text"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Goes to"
        },
        {
          "key": "style",
          "type": "select",
          "label": "Look",
          "options": [
            {
              "value": "link",
              "label": "Text link"
            },
            {
              "value": "primary",
              "label": "Red button"
            },
            {
              "value": "secondary",
              "label": "Outlined button"
            }
          ]
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "pc",
      "type": "section",
      "props": {
        "width": "full",
        "background": "{{bg}}",
        "align": "{{look}}",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 90,
          "paddingBottom": 90,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56,
          "paddingLeft": 20,
          "paddingRight": 20
        }
      },
      "children": [
        {
          "id": "pc-head",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "maxWidth": 1200,
              "marginLeft": "auto",
              "marginRight": "auto"
            }
          },
          "children": [
            {
              "id": "pc-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "pc-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "{{eyebrow}}",
                    "text": "{{heading}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "pc-intro",
                  "type": "text",
                  "props": {
                    "text": "{{intro}}",
                    "width": "full"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "pc-grid",
          "type": "row",
          "props": {
            "gap": 5,
            "stackOn": "mobile"
          },
          "styles": {
            "base": {
              "maxWidth": 1200,
              "marginLeft": "auto",
              "marginRight": "auto"
            }
          },
          "children": [
            {
              "id": "pc-card",
              "type": "column",
              "props": {
                "span": "{{span}}",
                "repeat": "cards"
              },
              "children": [
                {
                  "id": "pc-img",
                  "type": "image",
                  "props": {
                    "image": "{{image}}"
                  }
                },
                {
                  "id": "pc-body-row",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "children": [
                    {
                      "id": "pc-body",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "children": [
                        {
                          "id": "pc-kicker",
                          "type": "text",
                          "props": {
                            "text": "{{kicker}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "pc-num",
                          "type": "text",
                          "props": {
                            "text": "{{number}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "pc-title",
                          "type": "heading",
                          "props": {
                            "text": "{{title}}",
                            "headingLevel": 3
                          }
                        },
                        {
                          "id": "pc-copy",
                          "type": "copy-block",
                          "props": {
                            "text": "{{text}}",
                            "label": "{{label}}",
                            "note": "{{note}}",
                            "bars": "{{bars}}",
                            "bullets": "{{bullets}}",
                            "repeat": "copy"
                          }
                        },
                        {
                          "id": "pc-links-row",
                          "type": "row",
                          "props": {
                            "gap": 0,
                            "stackOn": "never"
                          },
                          "children": [
                            {
                              "id": "pc-links-col",
                              "type": "column",
                              "props": {
                                "span": 12
                              },
                              "styles": {
                                "base": {
                                  "display": "flex",
                                  "flexWrap": "wrap",
                                  "alignItems": "center",
                                  "columnGap": 16,
                                  "rowGap": 8
                                }
                              },
                              "children": [
                                {
                                  "id": "pc-link-1",
                                  "type": "buttons",
                                  "props": {
                                    "items": [
                                      {
                                        "label": "{{link1Label}}",
                                        "url": "{{link1Url}}",
                                        "style": "link"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "id": "pc-link-2",
                                  "type": "buttons",
                                  "props": {
                                    "items": [
                                      {
                                        "label": "{{link2Label}}",
                                        "url": "{{link2Url}}",
                                        "style": "link"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "pc-foot",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "maxWidth": 1200,
              "marginLeft": "auto",
              "marginRight": "auto",
              "marginTop": 8
            }
          },
          "children": [
            {
              "id": "pc-foot-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "pc-foot-links-row",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "styles": {
                    "base": {
                      "marginTop": 24
                    }
                  },
                  "children": [
                    {
                      "id": "pc-foot-links-col",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "styles": {
                        "base": {
                          "display": "flex",
                          "flexWrap": "wrap",
                          "alignItems": "center",
                          "columnGap": 16,
                          "rowGap": 12
                        }
                      },
                      "children": [
                        {
                          "id": "pc-foot-links",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{label}}",
                                "url": "{{url}}",
                                "style": "{{style}}"
                              }
                            ],
                            "repeat": "links"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
