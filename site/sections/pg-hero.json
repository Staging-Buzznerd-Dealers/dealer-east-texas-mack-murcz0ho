{
  "version": 2,
  "id": "pg-hero",
  "name": "Page hero (with photo)",
  "description": "Dark page header: breadcrumb, label, H1, tagline, intro paragraph and a photo on the right.",
  "css": "[data-bz-section=\"pg-hero\"] .bz-block { padding-block: 0; }\n[data-bz-section=\"pg-hero\"] .bz-block p { margin: 0; }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-crumb\"] p { font-size: 13px; line-height: normal; color: var(--copy-on-dark); margin-bottom: 20px; }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-crumb\"] a { color: inherit; text-decoration: none; }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-crumb\"] a:hover { color: var(--card); }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-crumb\"] strong { font-weight: 400; color: var(--card); }\n[data-bz-section=\"pg-hero\"] .bz-eyebrow { color: var(--accent-soft); margin-bottom: 14px; }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-h\"] h1 { font-size: 36px; line-height: normal; margin: 0 0 12px; color: var(--card); }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-sub\"] h2 { font-size: 18px; font-weight: 600; line-height: normal; margin: 0 0 20px; color: var(--accent-soft); }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-body\"] p { font-size: 16px; line-height: 1.7; color: #c9cbd0; }\n[data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-img\"] img { width: 100%; height: 320px; object-fit: cover; border-radius: 0; }\n@media (max-width: 640px) { [data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-h\"] h1 { font-size: 30px; } [data-bz-section=\"pg-hero\"] [data-bz-node=\"ph-img\"] img { height: 220px; } }",
  "props": [
    {
      "key": "crumb",
      "type": "text",
      "label": "Breadcrumb (current page)"
    },
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Label above the heading"
    },
    {
      "key": "headline",
      "type": "text",
      "label": "Heading (H1)"
    },
    {
      "key": "subhead",
      "type": "text",
      "label": "Tagline under the heading"
    },
    {
      "key": "body",
      "type": "textarea",
      "label": "Intro paragraph"
    },
    {
      "key": "image",
      "type": "image",
      "label": "Photo"
    }
  ],
  "nodes": [
    {
      "id": "ph",
      "type": "section",
      "props": {
        "width": "full",
        "background": "ink",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 32,
          "paddingBottom": 60,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingTop": 40,
          "paddingBottom": 40,
          "paddingLeft": 20,
          "paddingRight": 20
        }
      },
      "children": [
        {
          "id": "ph-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "center",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "gridColumns": "1.2fr 1fr",
              "gap": 40,
              "maxWidth": 1200,
              "marginLeft": "auto",
              "marginRight": "auto",
              "alignItems": "center"
            },
            "tablet": {
              "gridColumns": "1fr"
            }
          },
          "children": [
            {
              "id": "ph-copy",
              "type": "column",
              "props": {
                "span": 1
              },
              "children": [
                {
                  "id": "ph-crumb",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"/\">Home</a> / <strong>{{crumb}}</strong>",
                    "width": "full"
                  }
                },
                {
                  "id": "ph-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "{{eyebrow}}",
                    "text": "{{headline}}",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "ph-sub",
                  "type": "heading",
                  "props": {
                    "text": "{{subhead}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "ph-body",
                  "type": "text",
                  "props": {
                    "text": "{{body}}",
                    "width": "full"
                  }
                }
              ]
            },
            {
              "id": "ph-media",
              "type": "column",
              "props": {
                "span": 1
              },
              "children": [
                {
                  "id": "ph-img",
                  "type": "image",
                  "props": {
                    "image": "{{image}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
