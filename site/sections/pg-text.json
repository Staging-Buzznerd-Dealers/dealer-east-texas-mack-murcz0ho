{
  "version": 2,
  "id": "pg-text",
  "name": "Text band",
  "description": "A centred column of copy: label, heading, paragraphs and bullets, optional phone/address line from Locations, pill list, highlighted box and links.",
  "css": "[data-bz-section=\"pg-text\"] .bz-section:not(:has(h2)) { padding-block: 70px; }\n[data-bz-section=\"pg-text\"] .bz-headingblock h2 { margin-bottom: 20px; }\n[data-bz-section=\"pg-text\"] [data-bz-node^=\"pt-line\"] p { font-size: 16px; line-height: 1.7; margin: 0 0 16px; color: var(--copy); }\n[data-bz-section=\"pg-text\"] .bz-section--bg-ink [data-bz-node^=\"pt-line\"] p { color: var(--copy-on-dark); }\n[data-bz-section=\"pg-text\"] .bz-col[data-bz-node=\"pt-chips\"] { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }\n[data-bz-section=\"pg-text\"] .bz-col[data-bz-node=\"pt-chips\"]:empty { display: none; }\n[data-bz-section=\"pg-text\"] [data-bz-node^=\"pt-chip\"] p { font-size: 13px; line-height: normal; padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; color: #2a2b2f; margin: 0; }\n[data-bz-section=\"pg-text\"] .bz-col[data-bz-node^=\"pt-box\"] { display: block; background: var(--band-tan); border-radius: var(--radius-card); padding: 32px; margin-top: 8px; }\n[data-bz-section=\"pg-text\"] .bz-section--bg-ink .bz-col[data-bz-node^=\"pt-box\"] { background: var(--ink-raised); }\n[data-bz-section=\"pg-text\"] .bz-block[data-bz-node^=\"pt-box-link\"] { display: inline-block; margin-right: 16px; }\n[data-bz-section=\"pg-text\"] [data-bz-node^=\"pt-box-h\"] h3 { font-size: 18px; margin: 0 0 12px; }\n[data-bz-section=\"pg-text\"] [data-bz-node^=\"pt-box-p\"] p { font-size: 14px; line-height: 1.7; margin: 0 0 16px; }",
  "props": [
    {
      "key": "bg",
      "type": "select",
      "label": "Background",
      "options": [
        {
          "value": "card",
          "label": "White"
        },
        {
          "value": "paper",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Dark"
        }
      ],
      "default": "card"
    },
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Label above the heading"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading"
    },
    {
      "key": "phoneLine",
      "type": "list",
      "label": "City and phone line (from Locations)",
      "fields": [
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        },
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        }
      ]
    },
    {
      "key": "addressLine",
      "type": "list",
      "label": "Street address line (from Locations)",
      "fields": [
        {
          "key": "streetAddress",
          "type": "text",
          "label": "Street address"
        },
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        },
        {
          "key": "postalCode",
          "type": "text",
          "label": "ZIP"
        }
      ]
    },
    {
      "key": "copy",
      "type": "list",
      "label": "Body copy (paragraph, then optional bullets)",
      "fields": [
        {
          "key": "text",
          "type": "textarea",
          "label": "Paragraph"
        },
        {
          "key": "label",
          "type": "boolean",
          "label": "Show as a small bold lead-in (e.g. \"We provide:\")"
        },
        {
          "key": "note",
          "type": "boolean",
          "label": "Show as a bold highlighted note (e.g. \"Timeline: …\")"
        },
        {
          "key": "bars",
          "type": "boolean",
          "label": "Bullets use a line on the left instead of dots"
        },
        {
          "key": "bullets",
          "type": "list",
          "label": "Bullets",
          "fields": [
            {
              "key": "item",
              "type": "text",
              "label": "Bullet"
            }
          ]
        },
        {
          "key": "box",
          "type": "boolean",
          "label": "Show in a sand box (first line bold)"
        }
      ]
    },
    {
      "key": "chips",
      "type": "list",
      "label": "Pill list (e.g. towns served)",
      "fields": [
        {
          "key": "label",
          "type": "text",
          "label": "Pill"
        }
      ]
    },
    {
      "key": "copyAfter",
      "type": "list",
      "label": "Body copy after the pills",
      "fields": [
        {
          "key": "text",
          "type": "textarea",
          "label": "Paragraph"
        }
      ]
    },
    {
      "key": "links",
      "type": "list",
      "label": "Links and buttons",
      "fields": [
        {
          "key": "label",
          "type": "text",
          "label": "Link text"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Goes to"
        },
        {
          "key": "style",
          "type": "select",
          "label": "Look",
          "options": [
            {
              "value": "link",
              "label": "Text link"
            },
            {
              "value": "primary",
              "label": "Red button"
            },
            {
              "value": "secondary",
              "label": "Outlined button"
            }
          ]
        }
      ]
    },
    {
      "key": "boxes",
      "type": "list",
      "label": "Highlighted box",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "text",
          "type": "textarea",
          "label": "Text"
        },
        {
          "key": "linkLabel",
          "type": "text",
          "label": "Link text"
        },
        {
          "key": "linkUrl",
          "type": "url",
          "label": "Link goes to"
        },
        {
          "key": "link2Label",
          "type": "text",
          "label": "Second link text"
        },
        {
          "key": "link2Url",
          "type": "url",
          "label": "Second link goes to"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "pt",
      "type": "section",
      "props": {
        "width": "full",
        "background": "{{bg}}",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 90,
          "paddingBottom": 90,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingTop": 56,
          "paddingBottom": 56,
          "paddingLeft": 20,
          "paddingRight": 20
        }
      },
      "children": [
        {
          "id": "pt-row",
          "type": "row",
          "props": {
            "gap": 0,
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "maxWidth": 820,
              "marginLeft": "auto",
              "marginRight": "auto"
            }
          },
          "children": [
            {
              "id": "pt-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "pt-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "{{eyebrow}}",
                    "text": "{{heading}}",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "pt-line-a",
                  "type": "text",
                  "props": {
                    "text": "{{city}}, {{region}} — Phone: {{phone}}",
                    "width": "full",
                    "repeat": "phoneLine"
                  }
                },
                {
                  "id": "pt-line-b",
                  "type": "text",
                  "props": {
                    "text": "{{streetAddress}}, {{city}}, {{region}} {{postalCode}}",
                    "width": "full",
                    "repeat": "addressLine"
                  }
                },
                {
                  "id": "pt-copy",
                  "type": "copy-block",
                  "props": {
                    "text": "{{text}}",
                    "label": "{{label}}",
                    "note": "{{note}}",
                    "bars": "{{bars}}",
                    "bullets": "{{bullets}}",
                    "repeat": "copy",
                    "box": "{{box}}"
                  }
                },
                {
                  "id": "pt-chips-row",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "children": [
                    {
                      "id": "pt-chips",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "children": [
                        {
                          "id": "pt-chip",
                          "type": "text",
                          "props": {
                            "text": "{{label}}",
                            "width": "full",
                            "repeat": "chips"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pt-after",
                  "type": "copy-block",
                  "props": {
                    "text": "{{text}}",
                    "repeat": "copyAfter"
                  }
                },
                {
                  "id": "pt-links-row",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "styles": {
                    "base": {
                      "marginTop": 16
                    }
                  },
                  "children": [
                    {
                      "id": "pt-links-col",
                      "type": "column",
                      "props": {
                        "span": 12
                      },
                      "styles": {
                        "base": {
                          "display": "flex",
                          "flexWrap": "wrap",
                          "alignItems": "center",
                          "columnGap": 16,
                          "rowGap": 12
                        }
                      },
                      "children": [
                        {
                          "id": "pt-links",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{label}}",
                                "url": "{{url}}",
                                "style": "{{style}}"
                              }
                            ],
                            "repeat": "links"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "pt-boxes-row",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "children": [
                    {
                      "id": "pt-box",
                      "type": "column",
                      "props": {
                        "span": 12,
                        "repeat": "boxes"
                      },
                      "children": [
                        {
                          "id": "pt-box-h",
                          "type": "heading",
                          "props": {
                            "text": "{{title}}",
                            "headingLevel": 3
                          }
                        },
                        {
                          "id": "pt-box-p",
                          "type": "text",
                          "props": {
                            "text": "{{text}}",
                            "width": "full"
                          }
                        },
                        {
                          "id": "pt-box-link",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{linkLabel}}",
                                "url": "{{linkUrl}}",
                                "style": "link"
                              }
                            ]
                          }
                        },
                        {
                          "id": "pt-box-link2",
                          "type": "buttons",
                          "props": {
                            "items": [
                              {
                                "label": "{{link2Label}}",
                                "url": "{{link2Url}}",
                                "style": "link"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
