{
  "version": 2,
  "id": "utility-bar",
  "name": "Utility bar",
  "description": "The thin strip above the header: the rooftop's phone and address on the left, a short menu on the right.",
  "css": ".bz-sharedsection[data-bz-section=\"utility-bar\"] { color: #cfd2d6; font-size: 13px; line-height: normal; }\n[data-bz-section=\"utility-bar\"] .bz-block { padding-block: 0; }\n[data-bz-section=\"utility-bar\"] .bz-block p { margin: 0; font-size: 13px; line-height: normal; }\n[data-bz-section=\"utility-bar\"] .bz-block a { color: inherit; text-decoration: none; }\n[data-bz-section=\"utility-bar\"] .bz-block a:hover { color: var(--card); }\n[data-bz-section=\"utility-bar\"] .bz-nav { gap: var(--space-4); flex-wrap: nowrap; }\n[data-bz-section=\"utility-bar\"] .bz-navitem > a { font: 400 13px / normal var(--font-body); padding-block: 0; color: #cfd2d6; }\n[data-bz-section=\"utility-bar\"] .bz-navitem > a:hover { color: var(--card); }\n[data-bz-section=\"utility-bar\"] .bz-container { width: auto; }\n/* Styles for nodes repeated over the Locations binding live here: the renderer does not compile node styles inside a data-bound repeat. */\n[data-bz-section=\"utility-bar\"] .bz-block[data-bz-node^=\"ub-address\"] { color: #5a5d63; }\n@media (max-width: 640px) { [data-bz-section=\"utility-bar\"] .bz-block[data-bz-node^=\"ub-address\"] { display: none; } }",
  "props": [
    {
      "key": "rooftop",
      "type": "list",
      "label": "Phone and address",
      "fields": [
        {
          "key": "phone",
          "type": "text",
          "label": "Phone"
        },
        {
          "key": "phoneUrl",
          "type": "url",
          "label": "Phone link"
        },
        {
          "key": "streetAddress",
          "type": "text",
          "label": "Street address"
        },
        {
          "key": "city",
          "type": "text",
          "label": "City"
        },
        {
          "key": "region",
          "type": "text",
          "label": "State"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "ub",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "background": "inkDark",
          "paddingTop": 8,
          "paddingBottom": 8,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingLeft": 20,
          "paddingRight": 20
        }
      },
      "children": [
        {
          "id": "ub-row",
          "type": "row",
          "props": {
            "gap": 4,
            "align": "center",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "ub-contact",
              "type": "column",
              "props": {
                "span": 8
              },
              "styles": {
                "base": {
                  "display": "flex",
                  "alignItems": "center",
                  "flexWrap": "wrap",
                  "columnGap": 24,
                  "rowGap": 2
                }
              },
              "children": [
                {
                  "id": "ub-phone",
                  "type": "text",
                  "props": {
                    "text": "<a href=\"{{phoneUrl}}\">{{phone}}</a>",
                    "width": "full",
                    "repeat": "rooftop"
                  }
                },
                {
                  "id": "ub-address",
                  "type": "text",
                  "props": {
                    "text": "{{streetAddress}} {{city}}, {{region}}",
                    "width": "full",
                    "repeat": "rooftop"
                  }
                }
              ]
            },
            {
              "id": "ub-links",
              "type": "column",
              "props": {
                "span": 4,
                "align": "center"
              },
              "children": [
                {
                  "id": "ub-menu",
                  "type": "menu",
                  "props": {
                    "menuId": "utility",
                    "layout": "horizontal",
                    "align": "end",
                    "depth": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
