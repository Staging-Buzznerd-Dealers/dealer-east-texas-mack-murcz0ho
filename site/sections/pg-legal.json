{
  "version": 2,
  "id": "pg-legal",
  "name": "Legal text with contents list",
  "description": "A long numbered document: a sticky \"On this page\" list on the left and the sections on the right. Each section heading is an anchor the list links to.",
  "css": "[data-bz-section=\"pg-legal\"] .bz-block { padding-block: 0; }\n[data-bz-section=\"pg-legal\"] .bz-row[data-bz-node=\"plg-row\"] { align-items: start; }\n[data-bz-section=\"pg-legal\"] .bz-col[data-bz-node=\"plg-toc\"] { position: sticky; top: 24px; align-self: start; }\n[data-bz-section=\"pg-legal\"] [data-bz-node=\"plg-toc-h\"] p { margin: 0 0 16px; font: 600 13px / 1.2 var(--font-heading); letter-spacing: 1px; text-transform: uppercase; color: var(--muted); }\n[data-bz-section=\"pg-legal\"] .bz-block[data-bz-node^=\"plg-toc-link\"] { margin: 0 0 10px; }\n[data-bz-section=\"pg-legal\"] .bz-btn--link { display: inline; font: 400 14px / 1.3 var(--font-body); color: var(--copy); text-align: left; padding: 0; }\n[data-bz-section=\"pg-legal\"] .bz-block--buttons:has(.bz-btn--link) + .bz-block--buttons:has(.bz-btn--link) .bz-btn--link { border-left: 0 !important; padding-left: 0 !important; }\n[data-bz-section=\"pg-legal\"] .bz-btn--link:hover { color: var(--accent); }\n[data-bz-section=\"pg-legal\"] .bz-block .copy__p, [data-bz-section=\"pg-legal\"] .bz-block .copy__ul { font-size: 16px; line-height: 1.75; color: #2a2b2f; }\n[data-bz-section=\"pg-legal\"] .bz-block .copy__p { margin: 0 0 16px; }\n[data-bz-section=\"pg-legal\"] .bz-block .copy__p--label { margin: 0 0 12px; font: 700 16px / 1.4 var(--font-body); color: var(--ink); }\n[data-bz-section=\"pg-legal\"] .bz-block .copy__ul { margin: 0 0 16px; padding-left: 22px; display: flex; flex-direction: column; gap: 8px; }\n[data-bz-section=\"pg-legal\"] .bz-block .copy__p a { color: var(--accent); text-decoration: underline; }\n[data-bz-section=\"pg-legal\"] .bz-headingblock h2 { font-size: 22px; font-weight: 600; text-transform: none; line-height: 1.3; margin: 40px 0 16px; color: var(--ink); scroll-margin-top: 24px; }\n[data-bz-section=\"pg-legal\"] .bz-block--heading[data-bz-node^=\"plg-h\"] { scroll-margin-top: 24px; }\n@media (max-width: 1100px) { [data-bz-section=\"pg-legal\"] .bz-col[data-bz-node=\"plg-toc\"] { display: none; } }",
  "props": [
    {
      "key": "intro",
      "type": "list",
      "label": "Opening paragraphs",
      "fields": [
        {
          "key": "text",
          "type": "textarea",
          "label": "Paragraph"
        },
        {
          "key": "label",
          "type": "boolean",
          "label": "Show as a small bold sub-heading"
        },
        {
          "key": "bullets",
          "type": "list",
          "label": "Bullets",
          "fields": [
            {
              "key": "item",
              "type": "text",
              "label": "Bullet"
            }
          ]
        }
      ]
    },
    {
      "key": "sections",
      "type": "list",
      "label": "Sections",
      "fields": [
        {
          "key": "slug",
          "type": "text",
          "label": "Link name (letters and numbers, e.g. s1)"
        },
        {
          "key": "heading",
          "type": "text",
          "label": "Heading"
        },
        {
          "key": "copy",
          "type": "list",
          "label": "Body",
          "fields": [
            {
              "key": "text",
              "type": "textarea",
              "label": "Paragraph"
            },
            {
              "key": "label",
              "type": "boolean",
              "label": "Show as a small bold sub-heading"
            },
            {
              "key": "bullets",
              "type": "list",
              "label": "Bullets",
              "fields": [
                {
                  "key": "item",
                  "type": "text",
                  "label": "Bullet"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "plg",
      "type": "section",
      "props": {
        "width": "full",
        "background": "card",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 70,
          "paddingBottom": 70,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingTop": 44,
          "paddingBottom": 44,
          "paddingLeft": 16,
          "paddingRight": 16
        }
      },
      "children": [
        {
          "id": "plg-row",
          "type": "row",
          "props": {
            "gap": 8,
            "stackOn": "tablet"
          },
          "styles": {
            "base": {
              "maxWidth": 1200,
              "marginLeft": "auto",
              "marginRight": "auto"
            },
            "tablet": {
              "columnGap": 0,
              "rowGap": 24
            }
          },
          "children": [
            {
              "id": "plg-toc",
              "type": "column",
              "props": {
                "span": 3
              },
              "children": [
                {
                  "id": "plg-toc-h",
                  "type": "text",
                  "props": {
                    "text": "On This Page",
                    "width": "full"
                  }
                },
                {
                  "id": "plg-toc-link",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "label": "{{heading}}",
                        "url": "#{{slug}}",
                        "style": "link"
                      }
                    ],
                    "repeat": "sections"
                  }
                }
              ]
            },
            {
              "id": "plg-body",
              "type": "column",
              "props": {
                "span": 9
              },
              "children": [
                {
                  "id": "plg-intro",
                  "type": "copy-block",
                  "props": {
                    "text": "{{text}}",
                    "bullets": "{{bullets}}",
                    "repeat": "intro",
                    "label": "{{label}}"
                  }
                },
                {
                  "id": "plg-sections",
                  "type": "row",
                  "props": {
                    "gap": 0,
                    "stackOn": "never"
                  },
                  "children": [
                    {
                      "id": "plg-sec",
                      "type": "column",
                      "props": {
                        "span": 12,
                        "repeat": "sections"
                      },
                      "children": [
                        {
                          "id": "plg-h",
                          "type": "heading",
                          "anchor": "{{slug}}",
                          "props": {
                            "text": "{{heading}}",
                            "headingLevel": 2
                          }
                        },
                        {
                          "id": "plg-copy",
                          "type": "copy-block",
                          "props": {
                            "text": "{{text}}",
                            "bullets": "{{bullets}}",
                            "repeat": "copy",
                            "label": "{{label}}"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
