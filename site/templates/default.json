{
  "version": 2,
  "id": "default",
  "name": "Site template",
  "conditions": [
    {
      "type": "entireSite",
      "ref": null
    }
  ],
  "css": "[data-bz-node=\"header\"] .bz-block { padding-block: 0; }\n[data-bz-node=\"logo\"] .bz-logo__img { width: 52px; height: 52px; object-fit: contain; }\n[data-bz-node=\"header-brand\"] .bz-brand { display: flex; }\n[data-bz-node=\"wordmark\"] .bz-logo__word { font: 700 24px / 1 var(--font-heading); letter-spacing: 0.5px; color: var(--card); white-space: nowrap; }\n[data-bz-node=\"main-nav\"] .bz-nav { gap: 32px; }\n[data-bz-node=\"main-nav\"] .bz-navitem > a { font: 500 15px / 1.2 var(--font-body); color: #e5e6e8; }\n[data-bz-node=\"main-nav\"] .bz-navitem > a:hover,\n[data-bz-node=\"main-nav\"] .bz-navitem > a[aria-current='page'] { color: var(--card); }\n[data-bz-node=\"main-nav\"] .bz-menu-toggle { border: 0; color: var(--card); gap: 5px; padding: 6px; }\n[data-bz-node=\"main-nav\"] .bz-menu-toggle span { width: 26px; height: 3px; border-radius: 2px; }\n[data-bz-node=\"header-button\"] .bz-btns { margin: 0; justify-content: flex-end; flex-wrap: nowrap; }\n[data-bz-node=\"header-button\"] .bz-btn { font: 600 14px / 1 var(--font-body); padding: 12px 24px; white-space: nowrap; }\n@media (max-width: 1100px) {\n  [data-bz-node=\"main-nav\"] .bz-menu-wrap[data-open] > .bz-menu { background: var(--ink); border-top: 1px solid #23242a; border-bottom: 0; padding: 20px 40px; }\n  [data-bz-node=\"main-nav\"] .bz-menu-wrap[data-open] .bz-nav { gap: 18px; }\n  [data-bz-node=\"main-nav\"] .bz-menu-wrap[data-open] .bz-navitem > a { font-size: 16px; }\n}\n@media (max-width: 640px) {\n  [data-bz-node=\"logo\"] .bz-logo__img { width: 40px; height: 40px; }\n  [data-bz-node=\"wordmark\"] .bz-logo__word { font-size: 17px; }\n  [data-bz-node=\"header-button\"] .bz-btn { font-size: 13px; padding: 10px 14px; }\n  [data-bz-node=\"main-nav\"] .bz-menu-wrap[data-open] > .bz-menu { padding: 20px; }\n}",
  "nodes": [
    {
      "id": "utility",
      "type": "sharedSection",
      "props": {
        "sectionId": "utility-bar",
        "values": {
          "rooftop": {
            "source": "locations"
          }
        }
      }
    },
    {
      "id": "header",
      "type": "section",
      "props": {
        "width": "full",
        "paddingY": 0,
        "background": "ink"
      },
      "styles": {
        "base": {
          "paddingTop": 18,
          "paddingBottom": 18,
          "paddingLeft": 40,
          "paddingRight": 40
        },
        "tablet": {
          "paddingLeft": 24,
          "paddingRight": 24
        },
        "mobile": {
          "paddingTop": 14,
          "paddingBottom": 14,
          "paddingLeft": 20,
          "paddingRight": 20
        }
      },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "never"
          },
          "styles": {
            "base": {
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "between",
              "gap": 24,
              "flexWrap": "nowrap"
            },
            "mobile": {
              "gap": 10
            }
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 3
              },
              "styles": {
                "base": {
                  "display": "flex",
                  "alignItems": "center",
                  "gap": 12,
                  "flexShrink": 0
                },
                "mobile": {
                  "gap": 8,
                  "flexShrink": 1
                }
              },
              "children": [
                {
                  "id": "logo",
                  "type": "logo",
                  "props": {
                    "image": {
                      "src": "/images/logo-est-mack.webp",
                      "alt": "East Texas Mack Sales",
                      "width": 408,
                      "height": 408
                    },
                    "url": "/",
                    "height": 52
                  }
                },
                {
                  "id": "wordmark",
                  "type": "logo",
                  "props": {
                    "text": "EAST TEXAS MACK",
                    "url": "/"
                  }
                }
              ]
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": {
                "span": 6
              },
              "styles": {
                "base": {
                  "flexGrow": 1,
                  "display": "flex",
                  "justifyContent": "center"
                },
                "tablet": {
                  "flexGrow": 0,
                  "order": 3
                }
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "horizontal",
                    "align": "center",
                    "collapseOnMobile": true,
                    "depth": 1
                  }
                }
              ]
            },
            {
              "id": "header-cta",
              "type": "column",
              "props": {
                "span": 3
              },
              "styles": {
                "base": {
                  "flexShrink": 0
                },
                "tablet": {
                  "marginLeft": "auto"
                }
              },
              "children": [
                {
                  "id": "header-button",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "request-quote"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      }
    },
    {
      "id": "footer",
      "type": "sharedSection",
      "props": {
        "sectionId": "site-footer",
        "values": {
          "rooftop": {
            "source": "locations"
          }
        }
      }
    }
  ]
}
