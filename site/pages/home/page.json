          },
          "children": [
            {
              "id": "about-copy",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "about-h",
                  "type": "heading",
                  "props": {
                    "eyebrow": "Who We Are",
                    "text": "Welcome to East Texas Mack",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "about-body",
                  "type": "text",
                  "props": {
                    "text": "East Texas Mack has served fleets and owner-operators across the region for over 50 years, earning recognition as a three-time Mack Trucks National Dealer of the Year. Our Longview facility offers a full line of new and pre-owned Mack trucks, factory-certified service, a stocked parts warehouse, and flexible leasing and rental programs.\n\nWhether you're running a single truck or managing a large fleet, our team is here to keep you on the road with the equipment, parts, and support you need.",
                    "width": "full"
                  },
                  "styles": {
                    "base": {
                      "textColor": "#4a4d52"
                    }
                  }
                },
                {
                  "id": "about-stats",
                  "type": "statBand",
                  "props": {
                    "stats": [
                      {
                        "value": "50+",
                        "label": "Years in East Texas"
                      },
                      {
                        "value": "3×",
                        "label": "Mack Dealer of the Year"
                      },
                      {
                        "value": "120K+",
                        "label": "Parts SKUs in Stock"
                      }
                    ]
                  },
                  "styles": {
                    "base": {
                      "background": "card",
                      "paddingTop": 0,
                      "paddingBottom": 0
                    }
                  }
                }
              ]
            },
            {
              "id": "about-media",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "about-img",
                  "type": "image",
                  "props": {
                    "image": {
                      "src": "/images/about-trucks.webp",
                      "alt": "East Texas Mack trucks",
                      "width": 1569,
                      "height": 1045
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
