                    "eyebrow": "3× Mack National Dealer of the Year",
                    "text": "Large Selection of New and Pre‑Owned Inventory",
                    "headingLevel": 1
                  },
                  "styles": {
                    "base": {
                      "textColor": "card"
                    }
                  }
                },
