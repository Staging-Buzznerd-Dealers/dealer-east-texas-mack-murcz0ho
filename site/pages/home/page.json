      "styles": {
        "base": {
          "paddingTop": 90,
          "paddingBottom": 90
        },
        "mobile": {
          "paddingTop": 64,
          "paddingBottom": 64
        }
      },
      "children": [
        {
          "id": "about-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "center",
            "stackOn": "tablet"
          },
          "styles": {
            "base": {
              "columnGap": 60,
              "rowGap": 40
            },
            "tablet": {
              "columnGap": 0
