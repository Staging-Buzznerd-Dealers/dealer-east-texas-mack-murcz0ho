    {
      "id": "faq",
      "type": "sharedSection",
      "props": {
        "sectionId": "pg-faq",
        "values": {
          "items": [
            {
              "q": "Do you only sell Mack truck parts?",
              "a": "No. We supply parts for all makes and models of heavy-duty trucks."
            },
            {
              "q": "Do you have parts in stock?",
              "a": "Yes. We maintain a high inventory with a 95% fill rate."
            },
            {
              "q": "Do you offer same-day delivery?",
              "a": "Yes. Orders placed before noon qualify for same-day delivery."
            },
            {
              "q": "Can you help identify parts without a part number?",
              "a": "Yes. Our team can identify parts using VIN or truck details."
            },
            {
              "q": "Do you offer fleet pricing?",
              "a": "Yes. Qualified fleets can access preferred pricing and credit programs."
            }
          ]
        },
        "snapshots": {
