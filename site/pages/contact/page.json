{
  "version": 2,
  "nodes": [
    {
      "id": "contact-intro",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "paper",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingTop": 80,
          "paddingBottom": 24
        },
        "mobile": {
          "paddingTop": 56
        }
      },
      "children": [
        {
          "id": "contact-h",
          "type": "heading",
          "props": {
            "eyebrow": "Longview, Texas",
            "text": "Contact East Texas Mack",
            "headingLevel": 1
          }
        },
        {
          "id": "contact-text",
          "type": "text",
          "props": {
            "text": "Tell us what the job needs — a truck, a service appointment, parts, or a lease — and the right person on our team will get back to you."
          }
        }
      ]
    },
    {
      "id": "contact-forms",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "paper",
        "paddingY": 0
      },
      "styles": {
        "base": {
          "paddingBottom": 90
        },
        "mobile": {
          "paddingBottom": 56
        }
      },
      "children": [
        {
          "id": "contact-forms-row",
          "type": "row",
          "props": {
            "gap": 6,
            "align": "start",
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "contact-quote-col",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "contact-quote-form",
                  "type": "form",
                  "props": {
                    "formId": "request-a-quote",
                    "heading": "Get a quote",
                    "headingLevel": 2
                  }
                }
              ]
            },
            {
              "id": "contact-info-col",
              "type": "column",
              "props": {
                "span": 6
              },
              "children": [
                {
                  "id": "contact-info-form",
                  "type": "form",
                  "props": {
                    "formId": "request-info",
                    "heading": "Ask a question or book service",
                    "headingLevel": 2
                  }
                },
                {
                  "id": "contact-rental-form",
                  "type": "form",
                  "props": {
                    "formId": "rental-request",
                    "heading": "Leasing & rental",
                    "headingLevel": 2
                  }
                }
              ],
              "styles": {
                "base": {
                  "display": "flex",
                  "flexDirection": "column",
                  "gap": 32
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "contact-location",
      "type": "sharedSection",
      "props": {
        "sectionId": "location-band",
        "values": {
          "rooftop": {
            "source": "locations"
          }
        }
      }
    }
